# ──────────────────────────────────────────────────────────
# Neutrino Backend — Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────────────────

# ── Supabase (Required) ──────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── GitHub (Recommended — raises rate limit 60 → 5000/hr) ──
GITHUB_TOKEN=github_pat_xxxxx

# ── LLM — OpenRouter (Required, at least key 1) ─────────
OPENROUTER_API_KEY_1=sk-or-v1-xxxxx
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=

# ── Web Search (Optional — for Trend Intelligence) ──────
SERPER_API_KEY=

# ── CORS — comma-separated frontend URLs (Production) ───
# Leave empty for local development (defaults to allow all)
ALLOWED_ORIGINS=

# ── Legacy (Optional) ───────────────────────────────────
# SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
